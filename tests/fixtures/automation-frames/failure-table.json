{
	"about": "The failure table. Each case enters a body and applies one event per step whose turn comes. `visits` is each step's address in order, `caught` the try whose catch a visit entered (else null), `end` how the frame ended.",
	"cases": [
		{
			"name": "an empty body ends done",
			"body": [],
			"events": [],
			"visits": [],
			"caught": [],
			"end": { "end": "done" }
		},
		{
			"name": "outside a try a failure is noted, the body carries on, and the frame ends failed with the first",
			"body": [{ "kind": "action" }, { "kind": "action" }, { "kind": "action" }],
			"events": [
				{ "how": "failed", "failure": { "code": "refused", "message": "a" } },
				{ "how": "failed", "failure": { "code": "timeout", "message": "b" } },
				{ "how": "done" }
			],
			"visits": [[0], [1], [2]],
			"caught": [null, null, null],
			"end": { "end": "failed", "code": "refused" }
		},
		{
			"name": "inside a try a failure jumps to the catch, the rest of the try is skipped, and a caught failure is not remembered",
			"body": [
				{
					"kind": "try",
					"steps": [{ "kind": "action" }, { "kind": "action" }],
					"catch": [{ "kind": "action" }]
				},
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "failed", "failure": { "code": "unreachable", "message": "a" } },
				{ "how": "done" },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "catch", 0], [1]],
			"caught": [null, null, { "by": [0], "code": "unreachable" }, null],
			"end": { "end": "done" }
		},
		{
			"name": "a try that does not fail skips its catch",
			"body": [
				{ "kind": "try", "steps": [{ "kind": "action" }], "catch": [{ "kind": "action" }] },
				{ "kind": "action" }
			],
			"events": [{ "how": "took", "side": "try" }, { "how": "done" }, { "how": "done" }],
			"visits": [[0], [0, "try", 0], [1]],
			"caught": [null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "an empty catch still catches",
			"body": [
				{ "kind": "try", "steps": [{ "kind": "action" }, { "kind": "action" }], "catch": [] },
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "failed", "failure": { "code": "no_answer", "message": "a" } },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [1]],
			"caught": [null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "throw unwinds to the nearest try in its frame, through an if",
			"body": [
				{
					"kind": "try",
					"steps": [
						{ "kind": "if", "steps": [{ "kind": "throw" }, { "kind": "action" }] },
						{ "kind": "action" }
					],
					"catch": [{ "kind": "action" }]
				},
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "took", "side": "then" },
				{ "how": "thrown", "failure": { "code": "thrown", "message": "stop" } },
				{ "how": "done" },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "try", 0, "then", 0], [0, "catch", 0], [1]],
			"caught": [null, null, null, { "by": [0], "code": "thrown" }, null],
			"end": { "end": "done" }
		},
		{
			"name": "throw with no try ends the frame failed, the steps after it unreached",
			"body": [{ "kind": "action" }, { "kind": "throw" }, { "kind": "action" }],
			"events": [{ "how": "done" }, { "how": "thrown", "failure": { "code": "thrown", "message": "stop" } }],
			"visits": [[0], [1]],
			"caught": [null, null],
			"end": { "end": "failed", "code": "thrown" }
		},
		{
			"name": "a frame ended by a throw carries the failure noted before it",
			"body": [{ "kind": "action" }, { "kind": "throw" }],
			"events": [
				{ "how": "failed", "failure": { "code": "refused", "message": "a" } },
				{ "how": "thrown", "failure": { "code": "thrown", "message": "stop" } }
			],
			"visits": [[0], [1]],
			"caught": [null, null],
			"end": { "end": "failed", "code": "refused" }
		},
		{
			"name": "return ends the frame and adds no failure",
			"body": [{ "kind": "action" }, { "kind": "return" }, { "kind": "action" }],
			"events": [{ "how": "done" }, { "how": "return" }],
			"visits": [[0], [1]],
			"caught": [null, null],
			"end": { "end": "done" }
		},
		{
			"name": "a failure noted before a return still counts",
			"body": [{ "kind": "action" }, { "kind": "return" }, { "kind": "action" }],
			"events": [{ "how": "failed", "failure": { "code": "no_answer", "message": "a" } }, { "how": "return" }],
			"visits": [[0], [1]],
			"caught": [null, null],
			"end": { "end": "failed", "code": "no_answer" }
		},
		{
			"name": "a failure inside a catch is caught by the try that encloses its own",
			"body": [
				{
					"kind": "try",
					"steps": [{ "kind": "try", "steps": [{ "kind": "action" }], "catch": [{ "kind": "action" }] }],
					"catch": [{ "kind": "action" }]
				},
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "took", "side": "try" },
				{ "how": "failed", "failure": { "code": "refused", "message": "a" } },
				{ "how": "failed", "failure": { "code": "timeout", "message": "b" } },
				{ "how": "done" },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "try", 0, "try", 0], [0, "try", 0, "catch", 0], [0, "catch", 0], [1]],
			"caught": [
				null,
				null,
				null,
				{ "by": [0, "try", 0], "code": "refused" },
				{ "by": [0], "code": "timeout" },
				null
			],
			"end": { "end": "done" }
		},
		{
			"name": "a failure inside a catch that nothing encloses is noted, and the catch carries on",
			"body": [
				{
					"kind": "try",
					"steps": [{ "kind": "action" }],
					"catch": [{ "kind": "action" }, { "kind": "action" }]
				}
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "failed", "failure": { "code": "refused", "message": "a" } },
				{ "how": "failed", "failure": { "code": "timeout", "message": "b" } },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "catch", 0], [0, "catch", 1]],
			"caught": [null, null, { "by": [0], "code": "refused" }, null],
			"end": { "end": "failed", "code": "timeout" }
		},
		{
			"name": "an if takes a side, and leaving it at any depth continues after its owner",
			"body": [
				{
					"kind": "if",
					"steps": [{ "kind": "if", "steps": [{ "kind": "action" }] }],
					"else": [{ "kind": "action" }]
				},
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "then" },
				{ "how": "took", "side": "then" },
				{ "how": "done" },
				{ "how": "done" }
			],
			"visits": [[0], [0, "then", 0], [0, "then", 0, "then", 0], [1]],
			"caught": [null, null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "an absent side, an empty side and no side all lead on",
			"body": [
				{ "kind": "if", "steps": [{ "kind": "action" }] },
				{ "kind": "if", "steps": [] },
				{ "kind": "if" },
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "else" },
				{ "how": "took", "side": "then" },
				{ "how": "took", "side": null },
				{ "how": "done" }
			],
			"visits": [[0], [1], [2], [3]],
			"caught": [null, null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "a condition that cannot be read fails where the if stands: caught inside a try",
			"body": [
				{
					"kind": "try",
					"steps": [{ "kind": "if", "steps": [{ "kind": "action" }] }, { "kind": "action" }],
					"catch": [{ "kind": "action" }]
				}
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "failed", "failure": { "code": "unread", "message": "a" } },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "catch", 0]],
			"caught": [null, null, { "by": [0], "code": "unread" }],
			"end": { "end": "done" }
		},
		{
			"name": "a condition that cannot be read fails where the if stands: noted outside one, neither side taken",
			"body": [
				{ "kind": "if", "steps": [{ "kind": "action" }], "else": [{ "kind": "action" }] },
				{ "kind": "action" }
			],
			"events": [{ "how": "failed", "failure": { "code": "unread", "message": "a" } }, { "how": "done" }],
			"visits": [[0], [1]],
			"caught": [null, null],
			"end": { "end": "failed", "code": "unread" }
		},
		{
			"name": "a switch runs the case it took, then continues after itself",
			"body": [
				{
					"kind": "switch",
					"cases": [
						{ "steps": [{ "kind": "action" }] },
						{ "steps": [{ "kind": "action" }, { "kind": "action" }] }
					],
					"default": [{ "kind": "action" }]
				},
				{ "kind": "action" }
			],
			"events": [{ "how": "took", "side": "case:1" }, { "how": "done" }, { "how": "done" }, { "how": "done" }],
			"visits": [[0], [0, "case:1", 0], [0, "case:1", 1], [1]],
			"caught": [null, null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "a switch takes its default past the last case, and an absent default leads on",
			"body": [
				{ "kind": "switch", "cases": [{ "steps": [{ "kind": "action" }] }], "default": [{ "kind": "action" }] },
				{ "kind": "switch", "cases": [{ "steps": [{ "kind": "action" }] }] },
				{ "kind": "action" }
			],
			"events": [
				{ "how": "took", "side": "case:1" },
				{ "how": "done" },
				{ "how": "took", "side": "case:1" },
				{ "how": "done" }
			],
			"visits": [[0], [0, "case:1", 0], [1], [2]],
			"caught": [null, null, null, null],
			"end": { "end": "done" }
		},
		{
			"name": "a failure inside a case is caught by a try around the switch, the rest of the case skipped",
			"body": [
				{
					"kind": "try",
					"steps": [
						{
							"kind": "switch",
							"cases": [{ "steps": [{ "kind": "action" }, { "kind": "action" }] }],
							"default": [{ "kind": "action" }]
						},
						{ "kind": "action" }
					],
					"catch": [{ "kind": "action" }]
				}
			],
			"events": [
				{ "how": "took", "side": "try" },
				{ "how": "took", "side": "case:0" },
				{ "how": "failed", "failure": { "code": "refused", "message": "a" } },
				{ "how": "done" }
			],
			"visits": [[0], [0, "try", 0], [0, "try", 0, "case:0", 0], [0, "catch", 0]],
			"caught": [null, null, null, { "by": [0], "code": "refused" }],
			"end": { "end": "done" }
		},
		{
			"name": "a subject that cannot be read fails where the switch stands, no case taken",
			"body": [
				{ "kind": "switch", "cases": [{ "steps": [{ "kind": "action" }] }], "default": [{ "kind": "action" }] }
			],
			"events": [{ "how": "failed", "failure": { "code": "unread", "message": "a" } }],
			"visits": [[0]],
			"caught": [null],
			"end": { "end": "failed", "code": "unread" }
		}
	]
}
