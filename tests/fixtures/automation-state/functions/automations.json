[
	{
		"id": "gh-mentions",
		"revision": 1,
		"incarnation": "inc-mentions",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": {
				"kind": "event",
				"source": "github",
				"conditions": [{ "field": "reason", "operator": "is", "value": "mention" }]
			},
			"actions": [{ "kind": "tell_assistant", "when": "now" }]
		}
	},
	{
		"id": "gh-reviews",
		"revision": 2,
		"incarnation": "inc-reviews",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": {
				"kind": "event",
				"source": "github",
				"conditions": [{ "field": "reason", "operator": "is", "value": "review_requested" }]
			},
			"actions": [{ "kind": "tell_assistant", "when": "now" }]
		}
	},
	{
		"id": "gh-assigned",
		"revision": 1,
		"incarnation": "inc-assigned",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": {
				"kind": "event",
				"source": "github",
				"conditions": [{ "field": "reason", "operator": "is", "value": "assign" }]
			},
			"actions": [{ "kind": "tell_assistant", "when": "now" }]
		}
	},
	{
		"id": "gh-ci",
		"revision": 3,
		"incarnation": "inc-ci",
		"kind": "automation",
		"body": {
			"label": "A build broke",
			"enabled": true,
			"trigger": {
				"kind": "event",
				"source": "github",
				"conditions": [{ "field": "reason", "operator": "is", "value": "ci_activity" }]
			},
			"actions": [{ "kind": "tell_assistant", "when": "now" }]
		}
	},
	{
		"id": "freezer-cold",
		"revision": 1,
		"incarnation": "inc-freezer",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": {
				"kind": "crossing",
				"device": "ce:1c:44:06:3c:5d",
				"measure": "temperature",
				"direction": "below",
				"threshold": -10,
				"deadZone": 1,
				"coolDownSec": 0
			},
			"actions": [{ "kind": "tell_assistant", "when": "quietly" }]
		}
	},
	{
		"id": "lamp-off",
		"revision": 1,
		"incarnation": "inc-lamp-off",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": { "kind": "interval", "everyMin": 30 },
			"actions": [{ "kind": "device_set", "device": "aa:bb:cc:dd:ee:01", "verb": "off" }]
		}
	},
	{
		"id": "fan-on",
		"revision": 1,
		"incarnation": "inc-fan-on",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": { "kind": "interval", "everyMin": 60 },
			"actions": [{ "kind": "device_set", "device": "aa:bb:cc:dd:ee:02", "verb": "on" }]
		}
	},
	{
		"id": "warm-up",
		"revision": 1,
		"incarnation": "inc-warm-up",
		"kind": "function",
		"body": {
			"name": "Warm up",
			"params": [{ "name": "room", "type": "device" }],
			"steps": [
				{
					"kind": "action",
					"action": "device_set",
					"args": {
						"device": { "kind": "expression", "text": "room" },
						"verb": { "kind": "literal", "value": "on" }
					}
				},
				{
					"kind": "action",
					"action": "tell_assistant",
					"args": {
						"when": { "kind": "literal", "value": "quietly" },
						"message": { "kind": "literal", "value": "Warmed {room}" }
					}
				}
			]
		}
	},
	{
		"id": "warm",
		"revision": 1,
		"incarnation": "inc-warm",
		"kind": "automation",
		"body": {
			"enabled": true,
			"trigger": { "kind": "interval", "everyMin": 60 },
			"retryForMin": 60,
			"actions": [
				{
					"kind": "run_function",
					"function": "warm-up",
					"args": { "room": "aa:bb:cc:dd:ee:02" }
				}
			]
		}
	},
	{
		"id": "left-behind",
		"revision": 1,
		"incarnation": "inc-left-behind",
		"kind": "function",
		"body": {
			"name": "Left",
			"params": [],
			"steps": [
				{
					"kind": "action",
					"action": "tell_assistant",
					"args": { "when": { "kind": "literal", "value": "now" } }
				}
			]
		}
	}
]
