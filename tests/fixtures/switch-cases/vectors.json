		},
		{
			"name": "a value given twice in one case is an error on the second",
			"cases": [{ "values": ["a", "b", "A"] }],
			"choices": null,
			"issues": [{ "level": "error", "why": "twice", "case": 0, "chip": 2, "value": "A" }]
		},
		{
			"name": "a case with no values is an error on the case",
