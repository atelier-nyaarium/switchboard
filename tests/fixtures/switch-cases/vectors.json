			"taken": [{ "shown": " B ", "case": 0 }, { "shown": "c", "case": 1 }, { "shown": "d", "case": 2 }]
		},
		{
			"name": "a value given again ignoring case is an error on the later chip",
			"cases": [{ "values": ["Mention", "assign"] }, { "values": ["review", " mention "] }],
			"choices": null,
			"issues": [{ "level": "error", "why": "twice", "case": 1, "chip": 1, "value": " mention " }],
