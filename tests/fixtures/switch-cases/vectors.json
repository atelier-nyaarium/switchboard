		{ "value": "\tCI\n", "key": "ci" },
		{ "value": "MENTION", "key": "mention" },
		{ "value": "Review_Requested", "key": "review_requested" },
		{ "value": "a ", "key": "a " },
		{ "value": "", "key": "" }
	],
	"choiceFields": [
