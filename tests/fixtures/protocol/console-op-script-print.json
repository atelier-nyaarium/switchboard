{
	"kind": "script_print",
	"steps": [
		{
			"kind": "comment",
			"text": "Warm the room, then say so."
		},
		{
			"kind": "variable",
			"name": "humid",
			"value": {
				"kind": "expression",
				"text": "sensors.value(\"Hall\", \"humidity\")"
			}
		},
		{
			"kind": "if",
			"condition": "reading < threshold and humid > 60",
			"steps": [
				{
					"kind": "action",
					"action": "device_set",
					"args": {
						"device": {
							"kind": "literal",
							"value": "aa:bb:cc:dd:ee:01"
						},
						"verb": {
							"kind": "literal",
							"value": "on"
						}
					}
				},
				{
					"kind": "wait",
					"minutes": {
						"kind": "literal",
						"value": 5
					}
				}
			],
			"else": [
				{
					"kind": "return"
				}
			]
		},
		{
			"kind": "try",
			"steps": [
				{
					"kind": "run_function",
					"function": "fn-blink",
					"args": {
						"lamp": {
							"kind": "literal",
							"value": "aa:bb:cc:dd:ee:01"
						}
					}
				}
			],
			"catch": [
				{
					"kind": "action",
					"action": "tell_assistant",
					"args": {
						"when": {
							"kind": "literal",
							"value": "now"
						},
						"message": {
							"kind": "literal",
							"value": "It failed: {e}"
						}
					}
				}
			]
		}
	],
	"trigger": {
		"kind": "crossing",
		"device": "aa:bb:cc:dd:ee:10",
		"measure": "temperature",
		"direction": "below",
		"threshold": 2,
		"deadZone": 0,
		"coolDownSec": 0
	},
	"params": [
		{
			"name": "room",
			"type": "device"
		}
	],
	"functions": [
		{
			"id": "fn-blink",
			"name": "Blink",
			"params": [
				{
					"name": "lamp",
					"type": "device"
				}
			]
		}
	]
}
