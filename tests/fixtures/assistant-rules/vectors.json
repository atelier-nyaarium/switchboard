{
	"_comment": "Shared validation vectors for TypeScript and Kotlin. `codes`, `times` and `around` construct the typed value, or `values` lists several; `canonical` gives the stored value. Trimming removes ASCII whitespace at edges, before the length counts. `parses: false` is refused by the wire; `warning` is a choice that left its list. `matches` is TypeScript only, since the phone never matches.",
	"specs": [
		{
			"kind": "enumeration",
			"field": "reason",
			"label": "Reason",
			"options": [
				{ "value": "review_requested", "label": "Review requested" },
				{ "value": "mention", "label": "Mention" }
			]
		},
		{ "kind": "text", "field": "repository", "label": "Repository" }
	],
	"cases": [
		{
			"name": "a listed choice fits",
			"field": "reason",
			"test": "is",
			"value": "mention",
			"fits": true,
			"canonical": "mention"
		},
		{
			"name": "a choice takes is not",
			"field": "reason",
			"test": "is_not",
			"value": "mention",
			"fits": true,
			"canonical": "mention"
		},
		{
			"name": "a choice takes no contains",
			"field": "reason",
			"test": "contains",
			"value": "mention",
			"fits": false
		},
		{
			"name": "a choice no longer offered fits with a warning",
			"field": "reason",
			"test": "is",
			"value": "retired",
			"fits": true,
			"warning": true,
			"canonical": "retired"
		},
		{
			"name": "a choice is its value, never its label",
			"field": "reason",
			"test": "is",
			"value": "Mention",
			"fits": true,
			"warning": true
		},
		{
			"name": "a padded choice is trimmed to the listed value",
			"field": "reason",
			"test": "is",
			"value": "  mention  ",
			"fits": true,
			"canonical": "mention"
		},
		{
			"name": "text takes contains and keeps its case",
			"field": "repository",
			"test": "contains",
			"value": "Atelier",
			"fits": true,
			"canonical": "Atelier"
		},
		{
			"name": "tab, newline and return edges are trimmed",
			"field": "repository",
			"test": "is",
			"codes": [9, 97, 10, 13],
			"fits": true,
			"canonical": "a"
		},
		{
			"name": "vertical tab and form feed edges are trimmed",
			"field": "repository",
			"test": "is",
			"codes": [11, 97, 12],
			"fits": true,
			"canonical": "a"
		},
		{ "name": "an empty value does not fit", "field": "repository", "test": "is", "value": "", "fits": false },
		{ "name": "spaces alone do not fit", "field": "repository", "test": "is", "value": "   ", "fits": false },
		{ "name": "a byte order mark is a value", "field": "repository", "test": "is", "codes": [65279], "fits": true },
		{
			"name": "an information separator is a value",
			"field": "repository",
			"test": "is",
			"codes": [28],
			"fits": true
		},
		{ "name": "a no-break space is a value", "field": "repository", "test": "is", "codes": [160], "fits": true },
		{
			"name": "two hundred characters fit",
			"field": "repository",
			"test": "contains",
			"value": "x",
			"times": 200,
			"fits": true
		},
		{
			"name": "edge padding does not count toward the limit",
			"field": "repository",
			"test": "contains",
			"value": "x",
			"times": 200,
			"around": "  ",
			"fits": true
		},
		{
			"name": "two hundred and one do not",
			"field": "repository",
			"test": "contains",
			"value": "x",
			"times": 201,
			"fits": false,
			"parses": false
		},
		{ "name": "an undeclared field does not fit", "field": "kind", "test": "is", "value": "issue", "fits": false },
		{
			"name": "text takes does not contain",
			"field": "repository",
			"test": "contains_not",
			"value": "fork",
			"fits": true,
			"canonical": "fork"
		},
		{
			"name": "a choice takes no does not contain",
			"field": "reason",
			"test": "contains_not",
			"value": "mention",
			"fits": false
		},
		{
			"name": "a choice takes a list",
			"field": "reason",
			"test": "is",
			"values": ["mention", "review_requested"],
			"fits": true,
			"canonical": ["mention", "review_requested"]
		},
		{
			"name": "a list keeps its order and drops a repeat once trimmed",
			"field": "reason",
			"test": "is_not",
			"values": ["review_requested", " mention", "review_requested "],
			"fits": true,
			"canonical": ["review_requested", "mention"]
		},
		{
			"name": "one value left is a plain value",
			"field": "reason",
			"test": "is",
			"values": [" mention ", "mention"],
			"fits": true,
			"canonical": "mention"
		},
		{
			"name": "text drops a repeat case aside",
			"field": "repository",
			"test": "contains",
			"values": ["Atelier", "nyaa", "ATELIER"],
			"fits": true,
			"canonical": ["Atelier", "nyaa"]
		},
		{
			"name": "a blank in a list is dropped",
			"field": "repository",
			"test": "is",
			"values": ["", "app", "  "],
			"fits": true,
			"canonical": "app"
		},
		{
			"name": "a list of blanks has no value",
			"field": "repository",
			"test": "is",
			"values": ["", "   "],
			"fits": false
		},
		{ "name": "an empty list has no value", "field": "repository", "test": "is", "values": [], "fits": false },
		{
			"name": "a list holding a choice no longer offered fits with a warning",
			"field": "reason",
			"test": "is",
			"values": ["mention", "retired"],
			"fits": true,
			"warning": true,
			"canonical": ["mention", "retired"]
		},
		{
			"name": "the most values fit",
			"field": "repository",
			"test": "contains",
			"valuesPastMax": 0,
			"fits": true
		},
		{
			"name": "one more does not",
			"field": "repository",
			"test": "contains",
			"valuesPastMax": 1,
			"fits": false,
			"parses": false
		}
	],
	"matches": [
		{
			"name": "is any of takes either choice",
			"field": "reason",
			"test": "is",
			"values": ["mention", "review_requested"],
			"fields": { "reason": "review_requested" },
			"holds": true
		},
		{
			"name": "is any of refuses another choice",
			"field": "reason",
			"test": "is",
			"values": ["mention", "review_requested"],
			"fields": { "reason": "ci_new" },
			"holds": false
		},
		{
			"name": "is none of refuses a listed choice",
			"field": "reason",
			"test": "is_not",
			"values": ["mention", "review_requested"],
			"fields": { "reason": "mention" },
			"holds": false
		},
		{
			"name": "is none of takes another choice",
			"field": "reason",
			"test": "is_not",
			"values": ["mention", "review_requested"],
			"fields": { "reason": "ci_new" },
			"holds": true
		},
		{
			"name": "a choice matches exactly",
			"field": "reason",
			"test": "is",
			"value": "mention",
			"fields": { "reason": "Mention" },
			"holds": false
		},
		{
			"name": "a choice no longer offered matches nothing",
			"field": "reason",
			"test": "is",
			"value": "retired",
			"fields": { "reason": "retired" },
			"holds": false
		},
		{
			"name": "is none of a choice no longer offered takes any choice",
			"field": "reason",
			"test": "is_not",
			"value": "retired",
			"fields": { "reason": "mention" },
			"holds": true
		},
		{
			"name": "a list with a choice no longer offered matches the rest",
			"field": "reason",
			"test": "is",
			"values": ["mention", "retired"],
			"fields": { "reason": "mention" },
			"holds": true
		},
		{
			"name": "text is any of, case aside",
			"field": "repository",
			"test": "is",
			"values": ["atelier/app", "nyaa/core"],
			"fields": { "repository": "NYAA/core" },
			"holds": true
		},
		{
			"name": "contains any of finds one part",
			"field": "repository",
			"test": "contains",
			"values": ["fork", "app"],
			"fields": { "repository": "atelier/App" },
			"holds": true
		},
		{
			"name": "contains any of finds none",
			"field": "repository",
			"test": "contains",
			"values": ["fork", "core"],
			"fields": { "repository": "atelier/app" },
			"holds": false
		},
		{
			"name": "does not contain refuses a part",
			"field": "repository",
			"test": "contains_not",
			"value": "Fork",
			"fields": { "repository": "atelier/fork-app" },
			"holds": false
		},
		{
			"name": "contains none of takes text holding none",
			"field": "repository",
			"test": "contains_not",
			"values": ["fork", "archive"],
			"fields": { "repository": "atelier/app" },
			"holds": true
		},
		{
			"name": "contains none of refuses text holding one",
			"field": "repository",
			"test": "contains_not",
			"values": ["fork", "archive"],
			"fields": { "repository": "archive/app" },
			"holds": false
		},
		{
			"name": "a missing field fails is none of",
			"field": "reason",
			"test": "is_not",
			"values": ["mention", "review_requested"],
			"fields": {},
			"holds": false
		},
		{
			"name": "a missing field fails contains none of",
			"field": "repository",
			"test": "contains_not",
			"value": "fork",
			"fields": {},
			"holds": false
		},
		{
			"name": "a condition that does not fit never matches",
			"field": "reason",
			"test": "contains",
			"value": "ment",
			"fields": { "reason": "mention" },
			"holds": false
		}
	]
}
