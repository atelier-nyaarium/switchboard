{
	"_comment": "What src/shared/automation-walk.ts reaches for each automation, in written order. Each row is one entry: `reach` is action, step or unfollowedCall; `kind` is the action's kind, the step's action, or run_function for a call; `index` is its place in its list; `reason` says why a call was not followed. `functions` absent walks the automation alone. The phone's twin replays these cases.",
	"cases": [
		{
			"name": "one tell",
			"automation": {
				"enabled": true,
				"trigger": { "kind": "event", "source": "github", "conditions": [] },
				"actions": [{ "kind": "tell_assistant", "when": "now" }]
			},
			"reached": [{ "reach": "action", "path": "0", "index": 0, "kind": "tell_assistant" }]
		},
		{
			"name": "effects and tells keep their written order",
			"automation": {
				"enabled": true,
				"trigger": { "kind": "time", "time": "07:30", "weekdays": [1, 2, 3, 4, 5], "zone": "UTC" },
				"actions": [
					{ "kind": "device_set", "device": "aa:bb:cc:dd:ee:01", "verb": "on" },
					{ "kind": "tell_assistant", "when": "quietly", "message": "Heater on at {time}" },
					{ "kind": "ifttt_trigger", "event": "heater" },
					{ "kind": "device_set", "device": "aa:bb:cc:dd:ee:01", "verb": "toggle" }
				]
			},
			"reached": [
				{ "reach": "action", "path": "0", "index": 0, "kind": "device_set" },
				{ "reach": "action", "path": "1", "index": 1, "kind": "tell_assistant" },
				{ "reach": "action", "path": "2", "index": 2, "kind": "ifttt_trigger" },
				{ "reach": "action", "path": "3", "index": 3, "kind": "device_set" }
			]
		},
		{
			"name": "effects only",
			"automation": {
				"enabled": false,
				"trigger": {
					"kind": "crossing",
					"device": "ce:1c:44:06:3c:5d",
					"measure": "temperature",
					"direction": "above",
					"threshold": -10,
					"deadZone": 1,
					"coolDownSec": 0
				},
				"actions": [
					{ "kind": "ifttt_trigger", "event": "freezer", "value1": "{value}" },
					{ "kind": "device_set", "device": "aa:bb:cc:dd:ee:02", "verb": "off" }
				]
			},
			"reached": [
				{ "reach": "action", "path": "0", "index": 0, "kind": "ifttt_trigger" },
				{ "reach": "action", "path": "1", "index": 1, "kind": "device_set" }
			]
		},
		{
			"name": "a pointer reaches its function's steps under the call's path",
			"automation": {
				"enabled": true,
				"trigger": { "kind": "event", "source": "github", "conditions": [] },
				"actions": [
					{ "kind": "run_function", "function": "warm-up", "values": { "room": "aa:bb:cc:dd:ee:01" } }
				]
			},
			"functions": {
				"warm-up": {
					"name": "Warm up",
					"params": [{ "name": "room", "type": "device" }],
					"steps": [
						{
							"kind": "do",
							"action": "device_set",
							"args": {
								"device": { "kind": "expression", "text": "room" },
								"verb": { "kind": "literal", "value": "on" }
							}
						},
						{
							"kind": "do",
							"action": "tell_assistant",
							"args": { "when": { "kind": "literal", "value": "now" } }
						}
					]
				}
			},
			"reached": [
				{ "reach": "step", "path": "0.0", "index": 0, "kind": "device_set" },
				{ "reach": "step", "path": "0.1", "index": 1, "kind": "tell_assistant" }
			]
		},
		{
			"name": "a pointer to a function that is not held stands as a call, missing",
			"automation": {
				"enabled": true,
				"trigger": { "kind": "event", "source": "github", "conditions": [] },
				"actions": [{ "kind": "run_function", "function": "gone" }]
			},
			"functions": {},
			"reached": [{ "reach": "unfollowedCall", "path": "0", "kind": "run_function", "reason": "missing" }]
		},
		{
			"name": "walked without functions, a pointer stands as a call, not expanded",
			"automation": {
				"enabled": true,
				"trigger": { "kind": "interval", "everyMin": 60 },
				"actions": [{ "kind": "run_function", "function": "warm-up" }]
