{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "compact",
				"hooks": [
					{
						"type": "command",
						"command": "bun",
						"args": [
							"--config=${CLAUDE_PLUGIN_ROOT}/launch/bunfig.toml",
							"--tsconfig-override=${CLAUDE_PLUGIN_ROOT}/launch/tsconfig.json",
							"--no-env-file",
							"--no-install",
							"${CLAUDE_PLUGIN_ROOT}/dist/main-session-hook.js"
						],
						"timeout": 15
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "sh",
						"args": [
							"-c",
							"[ \"$PROJECT_NAME\" = host.assistant ] || exit 0; bun --config=\"$0/launch/bunfig.toml\" --tsconfig-override=\"$0/launch/tsconfig.json\" --no-env-file --no-install \"$0/dist/main-session-hook.js\" gate || { echo 'assistant gate failed to run' >&2; exit 2; }",
							"${CLAUDE_PLUGIN_ROOT}"
						],
						"timeout": 15,
						"onFailure": "block"
					}
				]
			}
		]
	}
}
