{
	"register": [
		{
			"name": "an operation no daemon was named for is abandoned",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [{ "operationId": "unstamped", "kind": "message", "state": "requested" }],
			"expected": { "staleOperationIds": ["unstamped"], "nextAgentState": "recovering" }
		},
		{
			"name": "an operation from the live daemon remains requested",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "creating",
			"operations": [
				{ "operationId": "live", "daemonInstanceId": "daemon-b", "kind": "start", "state": "requested" }
			],
			"expected": { "staleOperationIds": [], "nextAgentState": "creating" }
		},
		{
			"name": "a stale start makes its agent unavailable",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "creating",
			"operations": [
				{ "operationId": "start", "daemonInstanceId": "daemon-a", "kind": "start", "state": "requested" }
			],
			"expected": { "staleOperationIds": ["start"], "nextAgentState": "unavailable" }
		},
		{
			"name": "a stale message leaves its agent recovering",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [
				{ "operationId": "message", "daemonInstanceId": "daemon-a", "kind": "message", "state": "requested" }
			],
			"expected": { "staleOperationIds": ["message"], "nextAgentState": "recovering" }
		},
		{
			"name": "a stale stop preserves the agent state",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [
				{ "operationId": "stop", "daemonInstanceId": "daemon-a", "kind": "stop", "state": "requested" }
			],
			"expected": { "staleOperationIds": ["stop"], "nextAgentState": "working" }
		},
		{
			"name": "settled operations are not abandoned",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [
				{ "operationId": "accepted", "daemonInstanceId": "daemon-a", "kind": "start", "state": "accepted" },
				{
					"operationId": "indeterminate",
					"daemonInstanceId": "daemon-a",
					"kind": "message",
					"state": "indeterminate"
				}
			],
			"expected": { "staleOperationIds": [], "nextAgentState": "working" }
		},
		{
			"name": "a stale start outranks message and stop effects",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [
				{ "operationId": "message", "daemonInstanceId": "daemon-a", "kind": "message", "state": "requested" },
				{ "operationId": "stop", "daemonInstanceId": "daemon-a", "kind": "stop", "state": "requested" },
				{ "operationId": "start", "daemonInstanceId": "daemon-a", "kind": "start", "state": "requested" }
			],
			"expected": { "staleOperationIds": ["message", "stop", "start"], "nextAgentState": "unavailable" }
		},
		{
			"name": "a stale message outranks stop",
			"liveDaemonInstanceId": "daemon-b",
			"agentState": "working",
			"operations": [
				{ "operationId": "stop", "daemonInstanceId": "daemon-a", "kind": "stop", "state": "requested" },
				{ "operationId": "message", "daemonInstanceId": "daemon-a", "kind": "message", "state": "requested" }
			],
			"expected": { "staleOperationIds": ["stop", "message"], "nextAgentState": "recovering" }
		}
	],
	"reconcile": [
		{
			"name": "an exact fence is duplicate",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"knownActiveTurn": "turn-a",
			"report": { "turnId": "turn-a", "turnState": "inProgress" },
			"expected": { "kind": "duplicate" }
		},
		{
			"name": "an older generation is stale",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 9
			},
			"knownActiveTurn": "turn-a",
			"report": {},
			"expected": { "kind": "stale" }
		},
		{
			"name": "the known turn survives on the same process",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 5
			},
			"knownActiveTurn": "turn-a",
			"report": { "turnId": "turn-a", "turnState": "inProgress" },
			"expected": { "kind": "survives", "turnId": "turn-a" }
		},
		{
			"name": "a same-process different turn asks again",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 5
			},
			"knownActiveTurn": "turn-a",
			"report": { "turnId": "turn-b", "turnState": "inProgress" },
			"expected": { "kind": "askAgain" }
		},
		{
			"name": "a replaced process loses the prior turn and adopts the reported turn",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "turnId": "turn-b", "turnState": "inProgress" },
			"expected": { "kind": "lost", "turnId": "turn-a", "adoptTurnId": "turn-b" }
		},
		{
			"name": "a replaced process loses the prior turn when it reports none",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": {},
			"expected": { "kind": "lost", "turnId": "turn-a" }
		},
		{
			"name": "a reconcile adopts a running turn without a known turn",
			"currentFence": null,
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 0
			},
			"report": { "turnId": "turn-b", "turnState": "inProgress" },
			"expected": { "kind": "adopt", "turnId": "turn-b" }
		},
		{
			"name": "a same-process turn with no report remains recovering",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 5
			},
			"knownActiveTurn": "turn-a",
			"report": {},
			"expected": { "kind": "recovering", "turnId": "turn-a" }
		},
		{
			"name": "the known Codex turn survives when reported running",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "family": "codex", "turnId": "turn-a", "turnState": "inProgress" },
			"expected": { "kind": "survives", "turnId": "turn-a" }
		},
		{
			"name": "Codex loses a known turn when the new process reports another running turn",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "family": "codex", "turnId": "turn-b", "turnState": "inProgress" },
			"expected": { "kind": "lost", "turnId": "turn-a" }
		},
		{
			"name": "Codex loses a known turn when the new process reports no status",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "family": "codex" },
			"expected": { "kind": "lost", "turnId": "turn-a" }
		},
		{
			"name": "Codex leaves a reported terminal turn for its terminal event",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "family": "codex", "turnId": "turn-a", "turnState": "completed" },
			"expected": { "kind": "recovering", "turnId": "turn-a" }
		},
		{
			"name": "a Codex reconciliation with no known turn leaves the agent idle",
			"currentFence": null,
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 0
			},
			"report": { "family": "codex" },
			"expected": { "kind": "idle" }
		},
		{
			"name": "a replaced process leaves a reported terminal turn for its terminal event",
			"currentFence": {
				"daemonInstanceId": "daemon-a",
				"targetId": "target-a",
				"generation": 1,
				"lastEventId": 4
			},
			"receiptFence": {
				"daemonInstanceId": "daemon-b",
				"targetId": "target-a",
				"generation": 2,
				"lastEventId": 0
			},
			"knownActiveTurn": "turn-a",
			"report": { "turnId": "turn-a", "turnState": "completed" },
			"expected": { "kind": "recovering", "turnId": "turn-a" }
		}
	]
}
