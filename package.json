{
	"name": "switchboard",
	"version": "8.13.8",
	"private": true,
	"type": "module",
	"scripts": {
		"start:gateway": "bun run src/main-gateway.ts",
		"start:mcp": "bun run src/main-mcp.ts",
		"start:host-daemon": "bun run src/main-host-daemon.ts",
		"build": "bun run scripts/build.ts",
		"lint": "bun scripts/lint.ts",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"gen:fixtures": "bun scripts/gen-wire-fixtures.ts",
		"check:fixtures": "bun scripts/check-wire-fixtures.ts",
		"gen:facets": "bun scripts/gen-facet-vectors.ts",
		"check:facets": "bun scripts/check-facet-vectors.ts",
		"check:pinning": "bun run scripts/check-pinning-runtime.ts",
		"check:boot": "bun run scripts/check-boot-runtime.ts",
		"postinstall": "bun scripts/link-lexicon.mjs || node scripts/link-lexicon.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"qrcode-generator": "2.0.4",
		"unbash": "4.0.11",
		"vscode-jsonrpc": "9.0.2",
		"ws": "8.21.3",
		"zod": "4.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/ws": "8.18.1",
		"bun-types": "1.4.2",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	}
}
